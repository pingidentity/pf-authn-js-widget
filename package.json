{
  "name": "@ping-identity/pf-authn-js-widget",
  "version": "3.0.0",
  "description": "JavaScript Widget for the PingFederate Authentication API",
  "main": "./dist/pf.authn-widget.js",
  "types": "types/index.d.ts",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rimraf dist test/coverage",
    "lint": "eslint ./src/**.js",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:pingidentity/pf-authn-js-widget.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "Cookieless",
    "Redirectless",
    "Authentication API",
    "PingFederate",
    "Ping Identity",
    "API",
    "Authentication",
    "javascript"
  ],
  "author": "Ping Identity",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/pingidentity/pf-authn-js-widget/issues"
  },
  "browserslist": [
    "> 0.1%",
    "not ie <= 9"
  ],
  "homepage": "https://github.com/pingidentity/pf-authn-js-widget#readme",
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "babel-eslint": "^10.1.0",
    "eslint": "^5.16.0",
    "rimraf": "^2.7.1",
    "sass": "^1.100.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "core-js": "^3.49.0",
    "es6-promise": "^4.2.8",
    "formdata-polyfill": "^4.0.10",
    "handlebars": "^4.7.9",
    "qrcode": "^1.5.4",
    "query-string": "^7.1.3",
    "regenerator-runtime": "^0.14.1",
    "validate.js": "^0.13.1",
    "whatwg-fetch": "^3.6.20"
  }
}
