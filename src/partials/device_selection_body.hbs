{{#each devices as |device|}}
  {{#ifEq device.id ../selectedDeviceRef.id}}
    <span class="form-aside" id="deviceInfoBlockId">
      <p class="text-block text-block--small">
        <span class="text-block__text">{{../bodyText}}</span>
      </p>
      <p class="text-block">
      {{#ifEq device.type "Android"}}
        <span class="text-block__text">{{device.name}}</span>
      {{else ifEq device.type "iPhone"}}
        <span class="text-block__text">{{device.name}}</span>
      {{else ifEq device.type "PLATFORM"}}
          <span class="text-block__text">Biometrics</span>
      {{else ifEq device.type "SECURITY_KEY"}}
          <span class="text-block__text">Security Key</span>
      {{else ifEq device.type "FIDO2"}}
        <span class="text-block__text">PassKey</span>
      {{else ifEq device.type "TOTP"}}
        {{#if device.nickname}}
          <span class="text-block__text">{{device.nickname}}</span>
        {{else}}
          <span class="text-block__text">{{device.type}}</span>
        {{/if}}
      {{else ifEq device.type "YUBIKEY"}}
        <span class="text-block__text">YubiKey</span>
      {{else ifEq device.type "PINGID_DESKTOP"}}
        <span class="text-block__text">PingID Desktop</span>
      {{else ifEq device.type "PINGID_DESKTOP_GEN2"}}
        <span class="text-block__text">PingId Desktop</span>
      {{else ifEq device.type "PINGID_MOBILE"}}
        <span class="text-block__text">PingID Mobile</span>
      {{else}}
        <span class="text-block__text">{{device.type}}</span>
      {{/ifEq}}
      {{!-- P14C-85737: Change Method inline with the nickname line, matching
           the IK push-confirmation-waiting template (anchor inside the same
           <p class="text-block"> as the device nickname). --}}
      {{#if ../changeDeviceInline}}
        {{> change_device_link inline=true}}
      {{/if}}
      </p>
    </span>
  {{/ifEq}}
{{/each}}
