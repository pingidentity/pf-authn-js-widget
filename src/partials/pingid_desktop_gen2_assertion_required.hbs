<div class="card">
  <div class="org-logo">
    <img class="org-logo__image" src="{{logo}}" alt="Company Logo"/>
  </div>

  <div style="display: none" id="pingIdDesktopGen2UnsupportedId" class="icon-feedback icon-feedback--timeout icon-feedback--error">
    <span class="icon-feedback__icon pingicon-ghost-error"></span>
    <p class="icon-feedback__label">
      <p id="pingIdDesktopGen2ErrorText" class="icon-feedback--error">Unable to reach the PingID Desktop application</p>
    </p>
  </div>

  <form class="form" id="AuthnWidgetForm" data-actionId="pingIdDesktopGen2CheckAssertion">
    {{> errors}}
    <div class="spinner spinner--margin-bottom-small" id="pingIdDesktopGen2SpinnerId">
      <div class="spinner__icon" data-id="spinner"></div>
    </div>
    <div id="pingIdDesktopGen2AuthenticatingId" class="icon-feedback icon-feedback--success" style="margin-bottom: 30px;">
      <p class="icon-feedback__label">Authenticating</p>
    </div>
    {{> device_selection_body bodyText='Request sent to:'}}
    {{> change_device_link}}
    {{> forgot_device_link}}
    <div class="text-block" data-id="textblock">
      <div class="text-block--overflow-wrap">
        <a tabindex="0" data-actionId="cancelAuthentication" target="_self" class="anchor">
          Cancel</a>
      </div>
    </div>
    {{> admin_message}}
  </form>
</div>
